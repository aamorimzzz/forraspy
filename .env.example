# ══════════════════════════════════════════════════
# FORRASPY - Variáveis de Ambiente
# ══════════════════════════════════════════════════
# Copie este arquivo para .env e preencha suas chaves
# ══════════════════════════════════════════════════

# ── TELEGRAM (OBRIGATÓRIO) ──────────────────────
TELEGRAM_BOT_TOKEN=seu_token_do_botfather

# ── SOLANA APIs ─────────────────────────────────
# Helius (recomendado - grátis até 100k requests/dia)
# https://dev.helius.xyz/
HELIUS_API_KEY=

# Birdeye (melhor para trades e holders)
# https://birdeye.so/
BIRDEYE_API_KEY=

# Solscan Pro (fallback)
# https://pro-api.solscan.io/
SOLSCAN_API_KEY=

# ── EVM APIs ────────────────────────────────────
# Basescan (grátis)
# https://basescan.org/apis
BASESCAN_API_KEY=

# BSCScan (grátis)
# https://bscscan.com/apis
BSCSCAN_API_KEY=

# Moralis (recomendado para EVM - plano grátis disponível)
# https://moralis.io/
MORALIS_API_KEY=

# ── RPCs CUSTOM (opcional) ──────────────────────
# Se não configurar, usa RPCs públicos
SOLANA_RPC=
BASE_RPC=
BSC_RPC=
